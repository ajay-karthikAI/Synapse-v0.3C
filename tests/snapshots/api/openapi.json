{
  "components": {
    "schemas": {
      "AnswerEnvelope": {
        "additionalProperties": false,
        "description": "A validated answer. ``action`` distinguishes the three answer states.",
        "properties": {
          "action": {
            "enum": [
              "answer",
              "abstain",
              "medical_staff"
            ],
            "title": "Action",
            "type": "string"
          },
          "brief_available": {
            "description": "Whether an appointment brief can be built from this turn.",
            "title": "Brief Available",
            "type": "boolean"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/ClaimModel"
            },
            "title": "Claims",
            "type": "array"
          },
          "disclaimer": {
            "description": "Application-owned. No model contributes to it.",
            "title": "Disclaimer",
            "type": "string"
          },
          "doctor_evaluation": {
            "title": "Doctor Evaluation",
            "type": "string"
          },
          "excerpts": {
            "items": {
              "$ref": "#/components/schemas/ExcerptModel"
            },
            "title": "Excerpts",
            "type": "array"
          },
          "insufficient": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InsufficientModel"
              },
              {
                "type": "null"
              }
            ],
            "description": "Populated on an abstention, which IS the insufficient state."
          },
          "kind": {
            "const": "answer",
            "default": "answer",
            "title": "Kind",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "questions_for_doctor": {
            "items": {
              "type": "string"
            },
            "title": "Questions For Doctor",
            "type": "array"
          },
          "resolved_query": {
            "default": "",
            "description": "What a follow-up was resolved to for retrieval. Empty unless a rewrite actually happened. Model-generated: render as text.",
            "title": "Resolved Query",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceModel"
            },
            "title": "Sources",
            "type": "array"
          },
          "staff_message": {
            "default": "",
            "description": "Set only for the medical_staff action; application copy.",
            "title": "Staff Message",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "turn_index": {
            "minimum": 0.0,
            "title": "Turn Index",
            "type": "integer"
          }
        },
        "required": [
          "action",
          "summary",
          "claims",
          "doctor_evaluation",
          "questions_for_doctor",
          "limitations",
          "sources",
          "excerpts",
          "brief_available",
          "turn_index",
          "disclaimer"
        ],
        "title": "AnswerEnvelope",
        "type": "object"
      },
      "BriefClaimModel": {
        "additionalProperties": false,
        "description": "One claim in the brief, with its support level.",
        "properties": {
          "claim_id": {
            "title": "Claim Id",
            "type": "string"
          },
          "included": {
            "title": "Included",
            "type": "boolean"
          },
          "source_numbers": {
            "items": {
              "type": "integer"
            },
            "title": "Source Numbers",
            "type": "array"
          },
          "support": {
            "title": "Support",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "text",
          "support",
          "source_numbers",
          "included"
        ],
        "title": "BriefClaimModel",
        "type": "object"
      },
      "BriefNotesRequest": {
        "additionalProperties": false,
        "description": "Replace the patient's own notes.",
        "properties": {
          "notes": {
            "default": "",
            "maxLength": 4000,
            "title": "Notes",
            "type": "string"
          }
        },
        "title": "BriefNotesRequest",
        "type": "object"
      },
      "BriefQuestionModel": {
        "additionalProperties": false,
        "description": "One question in the brief, with where it came from.",
        "properties": {
          "origin": {
            "description": "Whether the patient or the system wrote it.",
            "title": "Origin",
            "type": "string"
          },
          "question_id": {
            "title": "Question Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "question_id",
          "text",
          "origin"
        ],
        "title": "BriefQuestionModel",
        "type": "object"
      },
      "BriefQuestionOrderRequest": {
        "additionalProperties": false,
        "description": "Reorder the questions by identifier.",
        "properties": {
          "order": {
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 0,
            "title": "Order",
            "type": "array"
          }
        },
        "required": [
          "order"
        ],
        "title": "BriefQuestionOrderRequest",
        "type": "object"
      },
      "BriefQuestionRequest": {
        "additionalProperties": false,
        "description": "Add one question the patient wrote themselves.",
        "properties": {
          "text": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "BriefQuestionRequest",
        "type": "object"
      },
      "BriefResponse": {
        "additionalProperties": false,
        "description": "The server-owned brief. A client edits it by named operation only.",
        "properties": {
          "available_sections": {
            "items": {
              "type": "string"
            },
            "title": "Available Sections",
            "type": "array"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/BriefClaimModel"
            },
            "title": "Claims",
            "type": "array"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "export_warning": {
            "title": "Export Warning",
            "type": "string"
          },
          "fill_ratio": {
            "title": "Fill Ratio",
            "type": "number"
          },
          "fits_one_page": {
            "title": "Fits One Page",
            "type": "boolean"
          },
          "included_sections": {
            "items": {
              "type": "string"
            },
            "title": "Included Sections",
            "type": "array"
          },
          "notes": {
            "title": "Notes",
            "type": "string"
          },
          "overflow_advice": {
            "items": {
              "type": "string"
            },
            "title": "Overflow Advice",
            "type": "array"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/BriefQuestionModel"
            },
            "title": "Questions",
            "type": "array"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceModel"
            },
            "title": "Sources",
            "type": "array"
          },
          "topic": {
            "title": "Topic",
            "type": "string"
          },
          "turn_index": {
            "title": "Turn Index",
            "type": "integer"
          }
        },
        "required": [
          "document_id",
          "turn_index",
          "topic",
          "notes",
          "questions",
          "claims",
          "sources",
          "included_sections",
          "available_sections",
          "fits_one_page",
          "fill_ratio",
          "overflow_advice",
          "export_warning",
          "disclaimer"
        ],
        "title": "BriefResponse",
        "type": "object"
      },
      "BriefSectionsRequest": {
        "additionalProperties": false,
        "description": "Choose which sections the export includes.",
        "properties": {
          "sections": {
            "items": {
              "type": "string"
            },
            "maxItems": 16,
            "minItems": 0,
            "title": "Sections",
            "type": "array"
          }
        },
        "required": [
          "sections"
        ],
        "title": "BriefSectionsRequest",
        "type": "object"
      },
      "BriefTopicRequest": {
        "additionalProperties": false,
        "description": "Replace the patient's own 'what I want to talk about' line.",
        "properties": {
          "topic": {
            "default": "",
            "maxLength": 2000,
            "title": "Topic",
            "type": "string"
          }
        },
        "title": "BriefTopicRequest",
        "type": "object"
      },
      "ClaimModel": {
        "additionalProperties": false,
        "description": "One displayed claim. Withheld claims never appear here at all.",
        "properties": {
          "claim_id": {
            "title": "Claim Id",
            "type": "string"
          },
          "source_numbers": {
            "items": {
              "type": "integer"
            },
            "title": "Source Numbers",
            "type": "array"
          },
          "support": {
            "description": "Partial support is shown and marked, never silently corrected.",
            "enum": [
              "supported",
              "partially_supported"
            ],
            "title": "Support",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "text",
          "source_numbers",
          "support"
        ],
        "title": "ClaimModel",
        "type": "object"
      },
      "DeletedResponse": {
        "additionalProperties": false,
        "description": "Confirmation that state was discarded.",
        "properties": {
          "deleted": {
            "title": "Deleted",
            "type": "boolean"
          }
        },
        "required": [
          "deleted"
        ],
        "title": "DeletedResponse",
        "type": "object"
      },
      "EmergencyEnvelope": {
        "additionalProperties": false,
        "description": "A red flag. Produced before retrieval, so it cites nothing.",
        "properties": {
          "brief_available": {
            "const": false,
            "default": false,
            "title": "Brief Available",
            "type": "boolean"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "kind": {
            "const": "emergency",
            "default": "emergency",
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "description": "Application copy. The one state that should interrupt.",
            "title": "Message",
            "type": "string"
          },
          "turn_index": {
            "minimum": 0.0,
            "title": "Turn Index",
            "type": "integer"
          }
        },
        "required": [
          "message",
          "turn_index",
          "disclaimer"
        ],
        "title": "EmergencyEnvelope",
        "type": "object"
      },
      "ExcerptModel": {
        "additionalProperties": false,
        "description": "A verbatim span the verifier matched, under its source's number.",
        "properties": {
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "quote": {
            "title": "Quote",
            "type": "string"
          },
          "source_number": {
            "title": "Source Number",
            "type": "integer"
          }
        },
        "required": [
          "source_number",
          "chunk_id",
          "quote"
        ],
        "title": "ExcerptModel",
        "type": "object"
      },
      "FailureEnvelope": {
        "additionalProperties": false,
        "description": "A fault. Fixed copy plus a typed code, and nothing else, ever.",
        "properties": {
          "brief_available": {
            "const": false,
            "default": false,
            "title": "Brief Available",
            "type": "boolean"
          },
          "code": {
            "description": "A closed AnswerFailureCode value.",
            "title": "Code",
            "type": "string"
          },
          "kind": {
            "const": "failure",
            "default": "failure",
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "description": "The single patient-facing message, identical for every code.",
            "title": "Message",
            "type": "string"
          },
          "turn_index": {
            "minimum": 0.0,
            "title": "Turn Index",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "message",
          "turn_index"
        ],
        "title": "FailureEnvelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Liveness. Says nothing about whether the artifact loaded.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InsufficientEnvelope": {
        "additionalProperties": false,
        "description": "No verified evidence. A designed state, not an error.",
        "properties": {
          "brief_available": {
            "const": false,
            "default": false,
            "title": "Brief Available",
            "type": "boolean"
          },
          "detail": {
            "$ref": "#/components/schemas/InsufficientModel"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "kind": {
            "const": "insufficient",
            "default": "insufficient",
            "title": "Kind",
            "type": "string"
          },
          "turn_index": {
            "minimum": 0.0,
            "title": "Turn Index",
            "type": "integer"
          }
        },
        "required": [
          "detail",
          "turn_index",
          "disclaimer"
        ],
        "title": "InsufficientEnvelope",
        "type": "object"
      },
      "InsufficientModel": {
        "additionalProperties": false,
        "description": "The complete patient-facing content for the insufficient-evidence state.",
        "properties": {
          "heading": {
            "title": "Heading",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "next_steps": {
            "items": {
              "type": "string"
            },
            "title": "Next Steps",
            "type": "array"
          },
          "not_a_judgement": {
            "description": "Prevents 'we found nothing' being read as 'there is nothing wrong'.",
            "title": "Not A Judgement",
            "type": "string"
          },
          "reason": {
            "description": "Operator-facing reason code.",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "heading",
          "message",
          "not_a_judgement",
          "next_steps"
        ],
        "title": "InsufficientModel",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "The shared passcode, exchanged for an access token.",
        "properties": {
          "passcode": {
            "description": "The shared access passcode.",
            "maxLength": 512,
            "minLength": 1,
            "title": "Passcode",
            "type": "string"
          }
        },
        "required": [
          "passcode"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "additionalProperties": false,
        "description": "A new session. The token is also set as an HttpOnly cookie.",
        "properties": {
          "expires_in_seconds": {
            "title": "Expires In Seconds",
            "type": "integer"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "expires_in_seconds"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "additionalProperties": false,
        "description": "Readiness. ``ready`` is false until every startup gate has passed.",
        "properties": {
          "artifact": {
            "additionalProperties": true,
            "title": "Artifact",
            "type": "object"
          },
          "detail": {
            "default": "",
            "description": "An exception TYPE name. Never a message.",
            "title": "Detail",
            "type": "string"
          },
          "failure_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Code"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "ready",
          "state"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "SessionResponse": {
        "additionalProperties": false,
        "description": "What the server holds for this session. No conversation content.",
        "properties": {
          "idle_ttl_seconds": {
            "title": "Idle Ttl Seconds",
            "type": "integer"
          },
          "max_turns": {
            "title": "Max Turns",
            "type": "integer"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "turn_active": {
            "title": "Turn Active",
            "type": "boolean"
          },
          "turn_count": {
            "title": "Turn Count",
            "type": "integer"
          }
        },
        "required": [
          "session_id",
          "turn_count",
          "max_turns",
          "turn_active",
          "idle_ttl_seconds"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SourceModel": {
        "additionalProperties": false,
        "description": "One numbered source, as it appears inline and in the source panel.",
        "properties": {
          "number": {
            "description": "Stable display number, assigned from retrieval order.",
            "minimum": 1.0,
            "title": "Number",
            "type": "integer"
          },
          "relevance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Retrieval relevance, 0..1. NOT a confidence and NOT a quality grade.",
            "title": "Relevance"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "description": "Empty when the recorded link was not http(s).",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "number",
          "source_id",
          "title",
          "url"
        ],
        "title": "SourceModel",
        "type": "object"
      },
      "StreamedTurnEnvelope": {
        "description": "The payload of the single terminal ``envelope`` server-sent event.\n\nA wrapper exists only so the union reaches the OpenAPI document. The stream\nroute returns an SSE body rather than a JSON model, and without something\ndeclared as its response the four envelope schemas would never be emitted\ninto ``components`` — leaving a generated client with no type for the one\nmessage that matters.",
        "discriminator": {
          "mapping": {
            "answer": "#/components/schemas/AnswerEnvelope",
            "emergency": "#/components/schemas/EmergencyEnvelope",
            "failure": "#/components/schemas/FailureEnvelope",
            "insufficient": "#/components/schemas/InsufficientEnvelope"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/AnswerEnvelope"
          },
          {
            "$ref": "#/components/schemas/EmergencyEnvelope"
          },
          {
            "$ref": "#/components/schemas/InsufficientEnvelope"
          },
          {
            "$ref": "#/components/schemas/FailureEnvelope"
          }
        ],
        "title": "StreamedTurnEnvelope"
      },
      "TransparencyResponse": {
        "additionalProperties": false,
        "description": "What this deployment is running, and what it has NOT been shown to be.",
        "properties": {
          "application_version": {
            "title": "Application Version",
            "type": "string"
          },
          "disclosures": {
            "description": "Mandatory statements. Never empty; never softened by configuration.",
            "items": {
              "type": "string"
            },
            "title": "Disclosures",
            "type": "array"
          },
          "evaluation": {
            "additionalProperties": true,
            "title": "Evaluation",
            "type": "object"
          },
          "privacy": {
            "additionalProperties": true,
            "title": "Privacy",
            "type": "object"
          },
          "sources": {
            "additionalProperties": true,
            "title": "Sources",
            "type": "object"
          },
          "system": {
            "additionalProperties": true,
            "title": "System",
            "type": "object"
          }
        },
        "required": [
          "application_version",
          "sources",
          "evaluation",
          "privacy",
          "system",
          "disclosures"
        ],
        "title": "TransparencyResponse",
        "type": "object"
      },
      "TurnRequest": {
        "additionalProperties": false,
        "description": "One patient question.\n\n``query`` is unrestricted free text by design — a patient must be able to\ndescribe a symptom in their own words. It is bounded in *length* only, and\nthe interface carries a persistent warning not to enter identifiers.",
        "properties": {
          "client_request_id": {
            "default": "",
            "description": "Client-generated id for idempotent retry. Re-sending the same id replays the previous result instead of running a second turn.",
            "maxLength": 128,
            "title": "Client Request Id",
            "type": "string"
          },
          "query": {
            "description": "The patient's question, in their own words.",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "TurnRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Backend for Synapse, a pre-clinical appointment-preparation prototype.\n\n**Not a medical device.** Not validated, not FDA cleared, not HIPAA compliant.\nNo clinician has reviewed any source, evaluation case, threshold or output.\n\nEvery route except `/healthz` and `/readyz` requires the `X-Service-Token`\nheader. Conversation routes additionally require an access token obtained from\n`/v1/access/login`. The browser is never expected to hold the service token: it\ncalls a same-origin server proxy, which forwards.\n",
    "title": "Synapse API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Alive. Says nothing about whether an artifact loaded.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Ready only when every startup gate passed and a service exists.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
