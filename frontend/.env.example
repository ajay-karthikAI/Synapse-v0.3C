# Copy to .env.local for development. Never commit a filled-in copy.
#
# There are no defaults for any of these. A missing value refuses to start,
# because a default passcode is an open door with a changelog entry.

# Where the FastAPI backend listens. Never reachable from the browser: the
# browser calls this Next.js server, which forwards.
SYNAPSE_API_URL=http://127.0.0.1:8000

# Proves a request came from this server rather than from a page. Must match
# the backend's SYNAPSE_SERVICE_TOKEN exactly. The browser never receives it.
SYNAPSE_SERVICE_TOKEN=

# Verifies the access cookie the backend signed. Must match the backend's
# SYNAPSE_JWT_SECRET exactly — there is one token in the system, issued by
# FastAPI and forwarded by this server.
SYNAPSE_JWT_SECRET=
